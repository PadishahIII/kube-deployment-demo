// kube-security CD — verify the signed image, package+sign the chart, deploy, verify.
//
// CD does NOT build, push, or scan images — the image already exists in the governed
// registry with a cosign signature (produced per SETUP_DEMO.md). CD's job:
//   1. cosign verify the digest-pinned image (fail = no deploy)
//   2. stamp the image ref + attestation annotations into per-build values
//   3. package + GPG-sign the chart, verify the signature with the committed public key
//   4. helm upgrade --install into the tenant namespace
//   5. verify (rollout, PolicyReports, netpol, RBAC, kubelet)
//
// No in-cluster negative test: rejection behaviour is proven offline by `kyverno test`
// (CI) and demonstrated live+manually in the demo script (SETUP_DEMO.md).
//
// Credentials:
//   dockerhub         Username/Password — registry auth for the cosign verify
//   cosign-pub        File — cosign public key (same credential ID as the sibling repo)
//   kind-kubeconfig   File — kubeconfig of the kind cluster on the node
//   helm-signing-key  File — GPG private key (armored) for chart provenance signing;
//                          the matching public key is committed at resources/helm/webapp/keys/public.asc
pipeline {
    agent any

    environment {
        COSIGN_VERSION = "v2.5.0"
        REGISTRY       = 'docker.io'
        DOCKERHUB_CRED = credentials('dockerhub')
        KUBECONFIG     = credentials('kind-kubeconfig')   // File credential
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10', daysToKeepStr: '30'))
    }

    parameters {
        choice(name: 'TENANT', choices: ['tenant-a', 'tenant-b'],
               description: 'Target tenant namespace (tenant-a=shop :8080, tenant-b=analytics :9090)')
        string(name: 'IMAGE',
               defaultValue: 'docker.io/padishahiii/kube-sec-shop@sha256:REPLACE_WITH_64_HEX_DIGEST',
               description: 'Digest-pinned image reference (@sha256:...) — validated; mutable tags are rejected')
        string(name: 'APP_VERSION', defaultValue: '1.0.0',
               description: 'Application version label (valid docker tag, <=63 chars)')
    }

    stages {
        stage('cleanup') {
            steps { cleanWs() }
        }

        stage('checkout') {
            steps {
                checkout scm
                sh 'mkdir -p reports rendered'
            }
        }

        stage('Initialize') {
            steps {
                script {
                    // IMAGE must be a digest-pinned reference — mutable tags cannot be deployed.
                    if (!(params.IMAGE ==~ /.+@sha256:[a-f0-9]{64}/)) {
                        error "IMAGE '${params.IMAGE}' is not a digest-pinned (@sha256:) reference — mutable tags cannot be deployed"
                    }
                    if (!(params.APP_VERSION ==~ /^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$/) || params.APP_VERSION.length() > 63) {
                        error "APP_VERSION '${params.APP_VERSION}' is not a valid Docker tag (<=63 chars)"
                    }
                    def app = (params.TENANT == 'tenant-a') ? 'shop' : 'analytics'
                    echo "tenant: ${params.TENANT} | app: ${app} | image: ${params.IMAGE} | version: ${params.APP_VERSION}"
                }
            }
        }

        stage('verify image - cosign') {
            steps {
                // The image is ALREADY signed (the app repo's pipeline signs it after Trivy scan).
                // CD only verifies — an unattested or tampered image fails here and is never deployed.
                withCredentials([file(credentialsId: 'cosign-pub', variable: 'COSIGN_KEY_PUB')]) {
                    sh '''
                        # The cosign image is distroless (no shell) and its entrypoint is already `cosign`,
                        # so we run the verify command directly (no script wrapper). Registry auth goes via
                        # env vars (COSIGN_REGISTRY_*), never CLI flags (which would show in the process list).
                        docker run --rm \\
                            -v ${COSIGN_KEY_PUB}:/keys/cosign.pub \\
                            -e COSIGN_REGISTRY_USERNAME="${DOCKERHUB_CRED_USR}" \\
                            -e COSIGN_REGISTRY_PASSWORD="${DOCKERHUB_CRED_PSW}" \\
                            ghcr.io/sigstore/cosign/cosign:${COSIGN_VERSION} \\
                            verify --key /keys/cosign.pub "${IMAGE}"
                    '''
                }
            }
        }

        stage('write image values') {
            steps {
                script {
                    // Stamp the digest-pinned image ref + the attestation annotations the Kyverno
                    // require-image-attestation / require-image-digest policies demand. The digest
                    // annotation MUST equal the image's digest (the policy checks this).
                    def digest = params.IMAGE.substring(params.IMAGE.indexOf('@') + 1)
                    writeFile(file: 'rendered/values-image.yaml', text: """
image:
  fullRef: ${params.IMAGE}
annotations:
  imageVerified: cosign
  imageDigest: ${digest}
""")
                    sh 'chmod 600 rendered/values-image.yaml'
                }
            }
        }

        stage('package & sign chart') {
            steps {
                script { env.CHART_TGZ = buildSignedChart() }
            }
        }

        stage('deploy') {
            steps {
                script {
                    def app = (params.TENANT == 'tenant-a') ? 'shop' : 'analytics'
                    sh """
                        set -euo pipefail
                        helm upgrade --install ${app} ${env.CHART_TGZ} -n ${params.TENANT} --create-namespace \
                            -f resources/helm/webapp/values-${params.TENANT}.yaml \
                            -f rendered/values-image.yaml
                        kubectl rollout status deployment/${app} -n ${params.TENANT} --timeout=5m
                        kubectl get pods -n ${params.TENANT} -o wide
                    """
                }
            }
        }

        stage('verify') {
            steps {
                script {
                    def app = (params.TENANT == 'tenant-a') ? 'shop' : 'analytics'
                    sh """
                        set -euo pipefail
                        # PolicyReports: the deployed pod must be compliant (no violations).
                        kubectl get policyreport -n ${params.TENANT} -o wide > reports/verify-policyreport.txt || true
                        # RBAC: the app ServiceAccount must have ZERO permissions.
                        kubectl auth can-i --list --as=system:serviceaccount:${params.TENANT}:${app}-sa -n ${params.TENANT} > reports/verify-rbac.txt || true
                        # NetworkPolicies: default-deny + the explicit cross-tenant allow.
                        kubectl get networkpolicy -n ${params.TENANT} -o json > reports/verify-netpol.json || true
                        # Kubelet hardening (node config — anonymous off, webhook authz, readOnlyPort 0).
                        kubectl get node -o json > reports/verify-node.json || true
                        echo "verification evidence written to reports/"
                    """
                }
            }
        }
    }

    post {
        always {
            script {
                try {
                    // Remove the per-build GPG keyrings + the sensitive image values file.
                    sh 'rm -f rendered/secring.gpg rendered/pubring.gpg rendered/values-image.yaml'
                    archiveArtifacts artifacts: 'reports/verify-*.txt, reports/verify-*.json, *.tgz, *.prov',
                                      allowEmptyArchive: true, fingerprint: true
                } catch (Exception e) {
                    echo "post cleanup/archival skipped (workspace unavailable — likely an early failure): ${e.message}"
                }
            }
        }
        success { echo 'CD OK — image verified, chart signed+verified, deployed, and verified.' }
        failure { echo 'CD FAILED' }
    }
}

// Package the in-repo Helm chart, GPG-sign it (private key from the `helm-signing-key`
// File credential), and verify the signature using ONLY the committed public key.
// Returns the path to the signed .tgz.
//
// GPG notes — Helm 4 signs/verifies with a built-in Go openpgp library (ProtonMail/go-crypto):
//   * it reads the OLD binary keyring format only; armored keys and the modern .kbx both
//     fail, so we dearmor first (`gpg --dearmor < key > ring.gpg`).
//   * --key must match the key's identity NAME (e.g. "Name <email>"), not the fingerprint —
//     derived from the committed public key.
//   * the public key MUST have the SIGN usage flag. `helm verify` matches via
//     KeysByIdUsage(keyId, KeyFlagSign); a cert-only key is loaded but never matched, failing
//     with "signature made by unknown entity". See tools/generate-helm-signing-key.sh.
def buildSignedChart() {
    def tgz = withCredentials([file(credentialsId: 'helm-signing-key', variable: 'HELM_SIGNING_KEY')]) {
        sh(script: """
            set -euo pipefail
            export GNUPGHOME=\$(mktemp -d); chmod 700 "\$GNUPGHOME"
            mkdir -p rendered
            gpg --dearmor < "\$HELM_SIGNING_KEY" > rendered/secring.gpg
            chmod 600 rendered/secring.gpg
            IDENTITY=\$(gpg --show-keys --with-colons resources/helm/webapp/keys/public.asc | awk -F: '/^uid/{print \$10; exit}')
            [ -n "\$IDENTITY" ] || { echo 'could not derive signing identity from public key' >&2; exit 1; }
            helm package --sign --key "\$IDENTITY" --keyring rendered/secring.gpg resources/helm/webapp/ 2>&1 | grep -oE '[^ ]+\\.tgz' | tail -1
        """, returnStdout: true).trim()
    }
    if (!tgz || !tgz.endsWith('.tgz')) {
        error "helm package produced no .tgz (chart signing failed)"
    }
    echo "signed chart: ${tgz}"
    // Verify with the committed public key ONLY — no secret key is present here.
    sh """
        set -euo pipefail
        export GNUPGHOME=\$(mktemp -d); chmod 700 "\$GNUPGHOME"
        gpg --dearmor < resources/helm/webapp/keys/public.asc > rendered/pubring.gpg
        helm verify ${tgz} --keyring rendered/pubring.gpg
    """
    return tgz
}
